/*threads*/
match /threads/{threadId} {
  allow get, list: if canManageOrg(orgId)
    || (
      signedIn()
      && request.auth.uid in resource.data.participantUids
    );

  allow create, update, delete: if false;

  match /messages/{messageId} {
    allow get, list: if canManageOrg(orgId)
      || (
        signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/orgs/$(orgId)/threads/$(threadId)
        ).data.participantUids
      );

    allow create, update, delete: if false;
  }
}




/*schoolActivities*/
match /schoolActivities/{activityId} {
  allow get, list: if canManageOrg(orgId)
    || (
      resource.data.schoolId is string
      && canManageSchoolActivities(
        orgId,
        resource.data.schoolId
      )
    );

  allow create: if canManageOrg(orgId)
    || (
      request.resource.data.orgId == orgId
      && request.resource.data.schoolId is string
      && canManageSchoolActivities(
        orgId,
        request.resource.data.schoolId
      )
    );

  allow update: if canManageOrg(orgId)
    || (
      resource.data.schoolId is string
      && request.resource.data.schoolId
        == resource.data.schoolId
      && request.resource.data.orgId == orgId
      && canManageSchoolActivities(
        orgId,
        resource.data.schoolId
      )
    );

  allow delete: if canManageOrg(orgId)
    || (
      resource.data.schoolId is string
      && canManageSchoolActivities(
        orgId,
        resource.data.schoolId
      )
    );
}

