  allow get, list: if hasOrgMembership(orgId);
  allow create, update, delete: if canManageOrg(orgId);
}





match /studentGamificationEvents/{eventId} {
  allow get, list: if canManageOrg(orgId)
    || hasAssignedClassSubjectAccess(
      orgId,
      resource.data
    );

  allow create: if canManageOrg(orgId)
    || (
      request.resource.data.orgId == orgId
      && hasAssignedClassSubjectAccess(
        orgId,
        request.resource.data
      )
      && request.resource.data.createdByPersonId
        == currentUserPersonId()
      && request.resource.data.status == "ACTIVE"
    );

  allow update, delete: if canManageOrg(orgId);
}






match /classroomDisplaySessions/{sessionId} {
  allow get, list: if canManageOrg(orgId)
    || hasAssignedClassSubjectAccess(
      orgId,
      resource.data
    );

  allow create: if canManageOrg(orgId)
    || (
      request.resource.data.orgId == orgId
      && hasAssignedClassSubjectAccess(
        orgId,
        request.resource.data
      )
      && request.resource.data.startedByPersonId
        == currentUserPersonId()
      && request.resource.data.status == "ACTIVE"
    );





allow update: if canManageOrg(orgId)
  || (
    hasAssignedClassSubjectAccess(
      orgId,
      resource.data
    )

    && request.resource.data.orgId
      == resource.data.orgId
    && request.resource.data.schoolId
      == resource.data.schoolId
    && request.resource.data.academicYearId
      == resource.data.academicYearId
    && request.resource.data.termId
      == resource.data.termId
    && request.resource.data.classId
      == resource.data.classId
    && request.resource.data.subjectKey
      == resource.data.subjectKey
    && request.resource.data.classSubjectOfferingId
      == resource.data.classSubjectOfferingId

    && request.resource.data.status
      in ["ACTIVE", "PAUSED", "ENDED"]

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "status",
        "displayThemeKey",
        "updatedAt",
        "endedAt",
        "lastHeartbeatAt"
      ])
  );

  allow delete: if false;
}




/*
 * ==========================================================
 * PDF resource library
 * ==========================================================
 */

match /pdfResources/{resourceId} {
  allow get, list: if canReadPdfResource(
    orgId,
    resource.data
  );

  allow create: if canManageOrg(orgId)
    && request.resource.data.id == resourceId
    && request.resource.data.orgId == orgId
    && request.resource.data.file is map
    && request.resource.data.file.contentType == "application/pdf"
    && request.resource.data.audience is map
    && request.resource.data.audience.kind
      in ["STAFF_ROLES", "STUDENTS"]

    && (
      request.resource.data.audience.kind != "STAFF_ROLES"
      || (
        request.resource.data.audience.targetRoleKeys is list
        && request.resource.data.audience.targetRoleKeys.size() > 0
      )
    )

    && (
      request.resource.data.audience.kind != "STUDENTS"
      || (
        request.resource.data.audience.schoolIds is list
        && request.resource.data.audience.schoolIds.size() > 0
        && request.resource.data.requiresAcknowledgement == false
      )
    );

  /*
   * بعد النشر لا نغيّر الملف أو الجمهور.
   * التعديل مسموح للعنوان والوصف والأرشفة فقط.
   */
  allow update: if canManageOrg(orgId)
    && request.resource.data.id == resource.data.id
    && request.resource.data.orgId == resource.data.orgId
    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "title",
        "description",
        "status",
        "archivedAt",
        "archivedByUid",
        "archivedByPersonId",
        "updatedAt"
      ]);

  /*
   * نحافظ على سجل الملف والإقرارات.
   * الحذف يُستبدل بالأرشفة.
   */
  allow delete: if false;

  match /acknowledgements/{actorId} {
    allow get: if canManageOrg(orgId)
      || (
        hasOrgMembership(orgId)
        && actorId == currentUserPersonId()
      );

    allow list: if canManageOrg(orgId);

    allow create: if hasOrgMembership(orgId)
      && pdfResourceExists(orgId, resourceId)
      && actorId == currentUserPersonId()

      && isTargetedStaffPdfResource(
        orgId,
        pdfResourceData(orgId, resourceId)
      )

      && pdfResourceData(
        orgId,
        resourceId
      ).requiresAcknowledgement == true

      && request.resource.data.keys().hasOnly([
        "id",
        "orgId",
        "resourceId",
        "actorKind",
        "actorId",
        "uid",
        "personId",
        "displayName",
        "roleKey",
        "schoolId",
        "acknowledgedAt"
      ])

      && request.resource.data.id == actorId
      && request.resource.data.orgId == orgId
      && request.resource.data.resourceId == resourceId

      && request.resource.data.actorKind == "STAFF"
      && request.resource.data.actorId == actorId

      && request.resource.data.uid == request.auth.uid
      && request.resource.data.personId == actorId
      && request.resource.data.roleKey == orgRole(orgId)

      && request.resource.data.displayName is string
      && request.resource.data.displayName != ""

      && request.resource.data.acknowledgedAt is int
      && request.resource.data.acknowledgedAt >= 0;

    /*
     * الإقرار يُنشأ مرة واحدة ولا يمكن التراجع عنه.
     */
    allow update, delete: if false;
  }
}






/*
       * ==========================================================
       * Closed fallback
       *
       * No normal member receives organization-wide access.
       * ==========================================================
       */

      match /{orgSubPath=**} {
        allow read, write: if canManageOrg(orgId);
      }
    }
  }
}
