/*evaluation*/


match /evaluationEvaluatorAssignments/{assignmentId} {
  allow get, list: if resource.data.schoolId is string
  && (
    canManageSchoolEvaluations(
      orgId,
      resource.data.schoolId
    )
    || (
      resource.data.evaluatorPersonId
        == currentUserPersonId()
      && hasSchoolAccess(
        orgId,
        resource.data.schoolId
      )
    )
  );

  allow create, update, delete:
    if canManageOrg(orgId);
}

match /evaluationSubmissions/{submissionId} {
  allow get, list: if canManageOrg(orgId)
    || (
      resource.data.schoolId is string
      && hasSchoolAccess(
        orgId,
        resource.data.schoolId
      )
      && (
        resource.data.evaluatorPersonId
          == currentUserPersonId()
        || (
          resource.data.targetPersonId
            == currentUserPersonId()
          && resource.data.status == "APPROVED"
        )
      )
    );

  allow create: if request.resource.data.schoolId is string
  && request.resource.data.evaluatorPersonId
    == currentUserPersonId()
  && canManageSchoolEvaluations(
    orgId,
    request.resource.data.schoolId
  );

  allow update: if canManageOrg(orgId)
  || (
    resource.data.schoolId is string
    && request.resource.data.schoolId
      == resource.data.schoolId
    && resource.data.evaluatorPersonId
      == currentUserPersonId()
    && request.resource.data.evaluatorPersonId
      == resource.data.evaluatorPersonId
    && canManageSchoolEvaluations(
      orgId,
      resource.data.schoolId
    )
  );

  allow delete: if false;
}

