{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "outDir": "lib",
    "rootDir": "..",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "paths": {
      "@takween/contracts": ["../packages/contracts/src/index.ts"],
      "@takween/domain": ["../packages/domain/src/index.ts"]
    },
    "skipLibCheck": true,
    "noImplicitReturns": true
  },
  "include": ["src"]
}
